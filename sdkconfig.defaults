# KAST sdkconfig.defaults — the config contract.
# Never hand-edit generated sdkconfig; change defaults here, delete sdkconfig, rebuild.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_APP_PROJECT_VER="0.1.0"

# --- Flash / PSRAM (ESP32-S3-N16R8) — mandatory, never remove ---
# CONFIG_SPIRAM is the master switch in v6.1 (no ESP32S3_SPIRAM_SUPPORT anymore).
CONFIG_SPIRAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# --- CPU / cache ---
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# --- Console on the CH340 UART (USB-C) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM_0=y

# --- Build hygiene ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Partition table ---
# Custom table (partitions.csv): factory app gets 3 MB at 0x10000 —
# SINGLE_APP_LARGE (~1.5 MB app) overflowed once the ws/mbedtls stack
# landed, and chat UI + OBS/SFX modules still need room to grow.
# NVS stays at 0x9000 so on-device Wi-Fi creds survive reflashes.
# Revisit for OTA (two-slot) when updates ship over the air.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- LVGL (via esp_lvgl_port) ---
# LV_CONF_SKIP: Kconfig-driven config, no lv_conf.h file to maintain.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
# Home screen typography (480x480 needs large fonts to breathe)
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# --- Crash forensics: panic backtrace lands in the 'coredump' flash
# partition (see partitions.csv); read it back with espcoredump.py after
# a field crash — no serial timing race with a human-in-the-loop bench.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# --- Panic-handler headroom: with stack-overflow CANARY checks the panic
# often runs on the IDLE task's stack, and the default 1536 B starves the
# coredump writer mid-dump (field-observed 2026-10-27: partition held
# body-without-header garbage after every crash). 4096 lets the dump
# finish so the backtrace survives.
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
