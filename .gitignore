# ============================================================================
# KAST .gitignore — day-one repo hygiene (Commandment IX)
# Journals, secrets, local originals, build output, session files never enter
# version control. Assume every commit is public and permanent.
# ============================================================================

# --- Dev journals / session documents (local-only, never committed) ---
KIMI.md
ROADMAP.md
PROGRESS.md

# --- Secrets & environment ---
.env
.env.*
*.pem
*.key
secrets.h
wifi_config.h

# --- Build output (ESP-IDF and Arduino/PlatformIO flavors) ---
build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
*.bin
*.elf
*.map
*.hex

# --- Local asset originals & reference shots (owner's photos, captures) ---
docs/assets/

# --- Third-party vendor bulk (downloadable from manufacturer; not our source) ---
docs/schematics/4.0inch_ESP32-4848S040/
docs/datasheets/*.pdf

# --- Session / scratch files ---
*.log
*.tmp
*.bak
*.swp
scratch/
session/
.cache/
tools_*.txt
tools_*.py
tools_bootlog.txt
