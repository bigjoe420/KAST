# KAST relay secrets -- copy to .env (gitignored) and fill in.
# Get these from kick.com/settings/developer (create an app).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8766/callback

# OBS Studio: Tools > WebSocket Server Settings > Enable WebSocket server.
# The Companion's Setup OBS action writes these private values to .env.
KAST_OBS_ENABLED=1
KAST_OBS_URL=ws://127.0.0.1:4455
KAST_OBS_PASSWORD=
# 1 = 100%, 0.5 = 50%, 1.5 = 150%; applies only to KAST SFX sources.
KAST_SFX_VOLUME=1
